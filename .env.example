# Apex Mart — environment template.
# Copy to .env for local dev, or paste these keys into Vercel → Project →
# Settings → Environment Variables for deployment. NEVER commit a real .env.
# Placeholder values only below.

# ── Required in production ──────────────────────────────────────────────────
# (The app refuses to boot in production if any of these still look like the
#  local dev defaults — see lib/env.ts.)

# Neon Postgres connection string. Use the NON-POOLING (direct) URL so
# `prisma migrate deploy` works; runtime queries work on it too.
DATABASE_URL=

# Session signing secret. Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public site URL (no trailing slash). After the first deploy, set to your
# Vercel URL, e.g. https://apex-mart.vercel.app
NEXTAUTH_URL=
APP_URL=

# ── Optional now (wire up in later phases) ──────────────────────────────────

# Phase C — transactional email (order receipts, verification, password reset).
# Without it, those emails are logged in dev and skipped; COD checkout still works.
RESEND_API_KEY=
# Sender identity for outgoing email (defaults to a Nova address if unset).
# EMAIL_FROM="Apex Mart <no-reply@apex-mart.vercel.app>"

# Phase D — Google sign-in. Leave unset to show only email/password sign-in.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# First-admin bootstrap: this email is promoted to admin on sign-in (set once,
# then manage the team in-app). Optional — the seeded admin already exists.
# BOOTSTRAP_ADMIN_EMAIL=

# Distributed rate limiting (e.g. Upstash Redis). Optional: without it, rate
# limiting falls back to per-instance in-memory windows. Stock reservations use
# Postgres, not Redis, so checkout does not need this.
# REDIS_URL=

# Ship the Content-Security-Policy in report-only mode for the first deploy
# (observe violations without blocking); unset later to enforce.
# CSP_REPORT_ONLY=true

# Extra browser origins allowed to call the /api/v1 REST API (comma-separated),
# on top of APP_URL. Only needed if a separate web client calls the API.
# API_CORS_ORIGINS=

# Log verbosity: fatal | error | warn | info | debug | trace (default: info).
# LOG_LEVEL=info

# ── Not used for this COD-only deploy (future / unused) ─────────────────────
# Payments are Cash-on-Delivery only — no Stripe/SafePay keys needed.
# STRIPE_SECRET_KEY= / STRIPE_WEBHOOK_SECRET= / NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Object storage / CDN (S3_*, CDN_BASE_URL) and SENTRY_DSN are unused here.
